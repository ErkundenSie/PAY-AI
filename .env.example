# Docker Compose 不识别 KEY=value 后面的行尾 # 注释，会把注释当成变量值。
# 说明只写在独立注释行；复制本文件为 .env 后只改等号右边。

# ===== Server =====
PORT=17621
JSON_BODY_LIMIT=2mb
# 仅在受信反向代理之后设为 1，才会采用 X-Forwarded-For 作为客户端 IP
TRUST_PROXY=0
# 激活前向 OpenAI 服务验证 Session；仅排障时才可临时设为 0
VERIFY_OPENAI_TOKEN_ON_ACTIVATION=1
# 设为 1 时，生成/删除 CDK、删卡、导出 Session 需先验证二级密码
ADMIN_REQUIRE_SECONDARY=0
# 推荐填写至少 32 字符的随机密钥；留空时首次启动会在 data/.admin-token-secret 生成随机持久化密钥
ADMIN_TOKEN_SECRET=
# 推荐填写 32 字节 base64url 密钥；留空时首次启动会在 data/.data-encryption-key 生成随机持久化密钥
DATA_ENCRYPTION_KEY=
# 首次建库时的默认管理员邮箱
ADMIN_EMAIL=admin@vru.cc
# 必填，至少 12 字符；首次建库时的后台登录密码
ADMIN_PASSWORD=
# 可选，首次建库时的默认二级密码（卡池/CDK/Session）
ADMIN_SECONDARY_PASSWORD=
# 已有数据库默认保留后台账号配置。需要用本文件中的值覆盖时设为 1，
# 成功启动后立即改回 0，避免每次重启都重置后台登录凭据。
ADMIN_CONFIG_SYNC=0
# 首次建库时的默认登录入口路径（可后台修改）
ADMIN_LOGIN_PATH=admin-login
# 首次建库时的默认管理后台路径（可后台修改）
ADMIN_PANEL_PATH=admin
# Docker 端口默认仅监听本机回环地址；对外部署请通过 HTTPS 反向代理，或明确改为 0.0.0.0。
APP_BIND_ADDRESS=127.0.0.1
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3310

# ===== MySQL =====
# 裸机连本机库用 127.0.0.1。docker compose 里 app 会强制改成 mysql:3306，这里不用改。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 必填：MySQL 密码
DB_PASSWORD=
DB_NAME=plus_papay
DB_POOL_LIMIT=60

# ===== 浏览器 =====
# 1 = 有头模式（调试用）
HEADFUL=0
# 留空使用 Playwright 自带 Chromium；可选 chrome / msedge
CHROMIUM_CHANNEL=
# 1 = 默认启用浏览器池；也可在后台「浏览器池」页切换（写入 MySQL，优先生效）
BROWSER_POOL=1
# 池大小，建议与前台并发一致
BROWSER_POOL_SIZE=2
# 槽位上限（128G 独服可设 16–24）
BROWSER_POOL_MAX_SIZE=24
# 槽位 CDP 起始端口（slot-N 使用 BASE+N）
BROWSER_POOL_BASE_PORT=19222
# hCaptcha VLM（推荐写在这里，重建 app 容器自动同步到 MySQL；亦可在后台保存）
# HCAPTCHA_VLM_API_KEY=sk-...
# HCAPTCHA_VLM_BASE_URL=https://api.openai.com/v1
# HCAPTCHA_VLM_MODEL=gpt-5.5
# 打码平台（createTask/getTaskResult，推荐用于 passive checkbox 兜底）
# HCAPTCHA_CAPTCHA_PLATFORM_API_KEY=CAP-...
# HCAPTCHA_CAPTCHA_PLATFORM_API_URL=https://api.capsolver.com
# HCAPTCHA_CAPTCHA_PLATFORM_TIMEOUT=180
# Session Cookie（Checkout 页面登录必需，与 AccessToken 不同）
# 从浏览器 DevTools → Application → Cookies → chatgpt.com 复制 __Secure-next-auth.session-token
# 建议导出全部 chatgpt.com Cookie，写入 Session JSON 的 cookies[] 或 cookieHeader 字段
# CHATGPT_SESSION_COOKIE=
# 裸机部署时 install.sh 会写入 HCAPTCHA_SOLVER_PYTHON
HCAPTCHA_SOLVER_PYTHON=

# ===== ChatGPT / Stripe（用于创建 Plus 订单的客户端 token，构建时由后端动态注入即可）=====
CHATGPT_TOKEN=
STRIPE_KEY=

# ===== Billing 默认值（可选；不填则全部从「资产池」按任务取卡 / 取地址）=====
BILLING_COUNTRY=US
BILLING_ADDRESS=
BILLING_CITY=
BILLING_STATE=
BILLING_ZIP=
BILLING_NAME=
BILLING_PHONE=

# ===== 银行卡（建议放在「资产池」管理，不要走环境变量）=====
CARD_NUMBER=
CARD_EXPIRY=
CARD_CVC=

# ===== 代理（强烈建议使用住宅代理，支持 {session} 占位符做 sticky session）=====
# 示例：http://USER:PASS@your-proxy-host:1000
# 示例：http://USER-session-{session}:PASS@your-proxy-host:1000
PROXY=

# ===== 邮箱通道 =====
# 临时邮箱 API（兼容 cloudflare_temp_email）
# 如：https://your-temp-email.example.com
INBOX_API_BASE=
# 临时邮箱可用域名（多行/逗号分隔）；为空则由后台「系统配置」管理
INBOX_EMAIL_DOMAINS=
# 自定义随机邮箱域名（用于 OpenAI 注册）
RANDOM_EMAIL_DOMAIN=
